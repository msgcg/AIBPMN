# Режим окружения: dev или production
DJANGO_ENV=dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-aibpmn-architecture-suite-2026-key

# Разрешенные хосты (через запятую)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Авторизация GigaChat API настраивается интерактивно в веб-интерфейсе
# (сохраняется в БД для авторизованных пользователей или в cookie для гостевого режима)


