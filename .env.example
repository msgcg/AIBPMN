# Режим окружения: dev или production
DJANGO_ENV=dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-aibpmn-architecture-suite-2026-key

# Разрешенные хосты (через запятую)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Авторизация GigaChat (API Сбера)
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Опционально: Client ID и Secret
# GIGACHAT_CLIENT_ID=your_client_id
# GIGACHAT_CLIENT_SECRET=your_client_secret

