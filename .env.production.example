# Продакшн конфигурация окружения
DJANGO_ENV=production
DJANGO_DEBUG=False

# Сгенерируйте уникальный секретный ключ для продакшна!
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here-minimum-50-characters

# Доменные имена вашего сервера (через запятую)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1

# Доверенные источники для защиты от CSRF (https://yourdomain.com)
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Безопасность cookie и SSL
DJANGO_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=31536000

# Авторизация GigaChat (API Сбера)
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra

